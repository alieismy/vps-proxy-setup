#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR/../lib/vps-proxy-setup
# vps-proxy-setup: first deployment of 3X-UI with a VLESS + REALITY node and a
# subscription published through Cloudflare Tunnel, plus read-only checks.
# See docs/solution-design.md for the command set and docs/detailed-design.md
# for the contracts of the commands.

set -Eeuo pipefail
umask 077
PATH='/usr/sbin:/usr/bin:/sbin:/bin'
LC_ALL=C
export PATH LC_ALL

readonly VPS_VERSION='0.1.0'

# Installed as /usr/local/bin/vps-proxy-setup with modules in
# /usr/local/lib/vps-proxy-setup and data in /usr/local/share/vps-proxy-setup;
# the repository uses the same relative layout (detailed design 2.1).
VPS_SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly VPS_SELF
readonly VPS_LIB_DIR="${VPS_SELF%/*/*}/lib/vps-proxy-setup"
readonly VPS_SHARE_DIR="${VPS_SELF%/*/*}/share/vps-proxy-setup"

if [ ! -r "$VPS_LIB_DIR/common.sh" ]; then
  printf '[x] 内部错误：找不到模块目录 %s\n' "$VPS_LIB_DIR" >&2
  exit 3
fi
. "$VPS_LIB_DIR/common.sh"
. "$VPS_LIB_DIR/pins.sh"
. "$VPS_LIB_DIR/platform.sh"
. "$VPS_LIB_DIR/inputs.sh"
. "$VPS_LIB_DIR/probe.sh"
. "$VPS_LIB_DIR/xuidb.sh"
. "$VPS_LIB_DIR/preflight.sh"
. "$VPS_LIB_DIR/check.sh"
. "$VPS_LIB_DIR/target.sh"
. "$VPS_LIB_DIR/deploy.sh"

# An unexpected command failure must not look like a FAIL result (exit 1).
# Only the main shell decides: inside $(...) or a pipeline the trap would also
# fire for expected non-zero statuses, and a real failure there reaches the
# main shell through the exit status anyway, but only when $(...) is assigned
# on its own (detailed design 8).
vps_on_error() {
  [ "$BASH_SUBSHELL" -eq 0 ] || return 0
  printf '[x] 内部错误：%s 处的命令以状态 %s 结束：%s\n' "$2" "$1" "$3" >&2
  exit "$VPS_EXIT_INTERNAL"
}
trap 'vps_on_error "$?" "${BASH_SOURCE[0]##*/}:$LINENO" "$BASH_COMMAND"' ERR
# Signals end the command with 128 + signal; the EXIT trap removes private
# files and the lock goes with its descriptor. Completed steps are not undone.
trap 'exit 130' INT
trap 'exit 143' TERM
trap vps_cleanup EXIT

usage() {
  cat <<'EOF'
用法：vps-proxy-setup <命令> [参数]

命令：
  deploy [--input <文件>] [--migrate]
              首次部署（交互执行）。当前版本只执行预检，不改动主机
  check       只读检查：逐项核对 3X-UI、订阅、监听、cloudflared 和加固状态
  target-check <主机名> [--probe-host <主机名>]
              在本机核实候选的 REALITY target，结果写入
              /etc/vps-proxy-setup/target-check/<主机名>

deploy 的输入文件每行一个 键=值，必须属于 root、权限 0600；没有的项交互读取：
  sub_host        订阅主机名（至少三级，例如 sub.example.com）
  node_ip         节点的公网 IPv4
  target          REALITY 的 target 主机名，先用 target-check 核实
  remark          入站备注，以国旗开头（--migrate 时不接受）
  users           使用者代号，逗号分隔，1～8 个（--migrate 时不接受）
  ipv6_ai_egress  on 或 off：是否让指定的 AI 服务经 IPv6 出站
  tunnel_token    Cloudflare Tunnel 的令牌（交互读取时不回显）

其他：
  --help       显示本帮助
  --version    显示版本

三个命令都要以 root 执行。
退出码：0 全部通过；1 有不符合项或被拒绝；2 用法或输入错误；3 内部错误。
EOF
}

main() {
  local cmd="${1-}"
  [ "$#" -eq 0 ] || shift
  case "$cmd" in
    deploy)
      # Detailed design 2.5 step 1: before anything else, even argument parsing.
      [ -t 0 ] || usage_error 'deploy 必须在交互终端中运行'
      cmd_deploy "$@"
      ;;
    check) cmd_check "$@" ;;
    target-check) cmd_target_check "$@" ;;
    --version) printf 'vps-proxy-setup %s\n' "$VPS_VERSION" ;;
    --help | -h) usage ;;
    '') usage >&2; exit "$VPS_EXIT_USAGE" ;;
    *) usage_error "未知命令：$cmd" ;;
  esac
}

main "$@"
